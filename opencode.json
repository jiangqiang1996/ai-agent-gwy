{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/**/*.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "mvn *": "allow",
      "rm -rf *": "deny",
      "del *": "deny"
    },
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    }
  },
  "agent": {
    "orchestrator": {
      "description": "多代理辅导编排器：分析用户意图，路由到合适的老师和学生代理，整合输出",
      "mode": "primary",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "task": true,
        "skill": true,
        "user-profile": true,
        "export-document": true,
        "grading": true,
        "question-generator": true,
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "xingce-zong-teacher": {
      "description": "行测总老师：系统教学行测所有模块，提供全局方法论和跨模块策略",
      "mode": "subagent",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true
      },
      "color": "#4ecdc4"
    },
    "xingce-yanyu-teacher": {
